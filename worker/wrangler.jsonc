{
  // INSTANCE-OWNED (merge=ours): the Caul deployment's Worker.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "caul-vtt",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    // The app's own origins, comma-separated — the only non-localhost origins the Worker
    // answers to. The custom domain and the github.io address behind it; localhost / 127.0.0.1
    // are always admitted for `wrangler dev`.
    "ALLOWED_ORIGIN": "https://caul.sortilege.online,https://sortilege-inc.github.io"
  },
  "durable_objects": {
    "bindings": [{ "name": "SESSION_ROOM", "class_name": "SessionRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionRoom"] }]
}
