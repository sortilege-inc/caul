        #caulAF79af1a00ab2df737c7 ^"Slow" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "When you spotlight Sarru and they don’t have a token on their stat block, they can’t act yet. Place a token on their stat block and describe what they’re preparing to do. When you spotlight Sarru and they have a token on their stat block, clear the token and they can act."
        }
