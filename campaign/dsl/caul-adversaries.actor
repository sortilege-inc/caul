EXTENSION "Caul_Adversaries" EXTENDS "Daggerheart_Core_Base" {
    NAME "Caul - the bestiary"
    VERSION "0.1.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-09-24"

    #caulADVAdskiyPeyzazhDrak1 ^"Adskiy Peyzazh Drakon" DEF {
        EXTENDS #daggerheartAdversary000000001 ^"Adversary"
        PROPERTIES {
            ^"Tier" INTEGER 2
            ^"Role" STRING "Solo"
            ^"Description" STRING "A monstrous dragon from the hellscape, immortal and eternally exploring the world."
            ^"Motives & Tactics" LIST [ "Survey territory", "crush opposition", "inspire awe", "collect specimens" ]
            ^"Difficulty" INTEGER 16
            ^"Damage Thresholds" DEF { ^"Major" INTEGER 15 ^"Severe" INTEGER 30 }
            ^"Hit Points" INTEGER 10
            ^"Stress" INTEGER 6
            ^"Attack Modifier" INTEGER 4
        }
        ATTACK {
        ^"Bite" DEF { ^"Range" STRING "Very Close" ^"Damage" STRING "3d10+5 phy" }
    }
        EXPERIENCES {
        ^"Immortal Knowledge" INTEGER 3
        ^"Flight" INTEGER 3
    }
        FEATURES {
        #caulAF0ce71c29828709930d ^"Relentless (2)" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Type" STRING "Passive"
            ^"Description" STRING "The Drakon can be spotlighted up to two times per GM turn."
        }
        #caulAFedfd5fbc1a33c34e3b ^"Terrifying" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Type" STRING "Passive"
            ^"Description" STRING "When the Drakon makes a successful attack, all PCs within Far range must lose a Hope and you gain a Fear."
        }
        #caulAFafc739de70f92642e0 ^"Hellfire Breath" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Type" STRING "Action"
            ^"Description" STRING "Spend 2 Fear to exhale demonic flames in a cone toward all targets within Far range in front of the Drakon. Targets must succeed on an Agility Reaction Roll (Difficulty 17) or take 4d8+8 magic damage and become Vulnerable (burning) until they extinguish the flames."
        }
        #caulAFbe775aeabfab18bfba ^"Immortal Regeneration" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Type" STRING "Passive"
            ^"Description" STRING "At the start of each GM turn, if the Drakon has marked at least 1 HP, it clears 1 HP."
        }
        #caulAF203733f2be9b33baaf ^"Crushing Landing" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Type" STRING "Action"
            ^"Description" STRING "While flying, the Drakon can dive-bomb the battlefield. Mark a Stress to move up to Far range and land. All creatures within Very Close range of the landing point must succeed on an Agility Reaction Roll (Difficulty 16) or take 2d12+4 physical damage and be knocked Prone."
        }
        #caulAFec52985e68984212d1 ^"Ancient Fury" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
        }
    }
    }

    #caulADVAshbegetsTidePrie2 ^"Ash-begets-Tide, Priest of Ossa-in-Abstentia" DEF {
        EXTENDS #daggerheartAdversary000000001 ^"Adversary"
        PROPERTIES {
            ^"Tier" INTEGER 3
            ^"Role" STRING "Leader"
            ^"Motives & Tactics" LIST [ "Erode hope", "grow new life from death", "shepherd the living into decay" ]
            ^"Difficulty" INTEGER 16
            ^"Damage Thresholds" DEF { ^"Major" INTEGER 21 ^"Severe" INTEGER 40 }
            ^"Hit Points" INTEGER 6
            ^"Stress" INTEGER 6
            ^"Attack Modifier" INTEGER 3
        }
        ATTACK {
        ^"Wand" DEF { ^"Range" STRING "Far" ^"Damage" STRING "3d8+3 mag" }
    }
        EXPERIENCES {
        ^"Disheartening" INTEGER 3
        ^"Entropic Magic" INTEGER 3
    }
        FEATURES {
        #caulAF697e30011494c9003a ^"Doctrine of the End" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "The Priest and all allies within Close range deal an additional 1d12 damage to Vulnerable targets."
        }
        #caulAFc41bf4d430ae0f2dcf ^"Life From Death" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "Spend a Fear to target a corpse or dead plant within Far range. Create 1d4 Treant Saplings at the location of the target."
        }
        #caulAF212ec3becfa26c1387 ^"We're All Dying Inside" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "Mark a Stress and select a target within Far range. The target must make a Strength Reaction Roll. On a failure, the target marks a HP and becomes Vulnerable until they clear HP."
        }
        #caulAF3f274855649feaac30 ^"Psalm of Inevitability" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "When a PC within Close range of the Priest fails a roll, they must mark a Stress."
        }
        #caulAF06c9b9d13fd52e503f ^"Momentum" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "When this adversary makes a successful attack against a PC, gain a Fear."
        }
    }
    }

    #caulADVBorek0000000000003 ^"Borek" DEF {
        EXTENDS #daggerheartAdversary000000001 ^"Adversary"
        PROPERTIES {
            ^"Tier" INTEGER 3
            ^"Role" STRING "Social"
            ^"Description" STRING "Head of the Syndicate, known colloquially as the Dimmers"
            ^"Motives & Tactics" LIST [ "Leverage information", "Buy low/sell high", "avoid direct confrontation" ]
            ^"Difficulty" INTEGER 16
            ^"Damage Thresholds" DEF { ^"Major" INTEGER 16 ^"Severe" INTEGER 32 }
            ^"Hit Points" INTEGER 6
            ^"Stress" INTEGER 5
        }
        ATTACK {
        ^"Attack" DEF { ^"Range" STRING "Melee" ^"Damage" STRING "3d6+3 phy" }
    }
        EXPERIENCES {
        ^"Influence" INTEGER 3
        ^"Important Friends" INTEGER 3
    }
        FEATURES {
        #caulAF12a4da736f906995ae ^"Throw them over the Ledge!" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "Spend a Fear per PC in the party to have the group condemned for crimes real or imagined. A PC who succeeds on a Presence Roll can demand trial by combat or another special form of trial."
        }
        #caulAF7edd4cff1fafc81e70 ^"Get 'em, Boys!" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "Once per scene, mark a Stress to summon six Tier 3 Minions, who appear at Close range to enforce Borek's will."
        }
        #caulAF860dba3cae8ea27399 ^"Casus Belli" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "Long-Term Countdown (8). Spend a Fear to activate after the Borek's desire for conflict is first revealed. When it triggers, Borek has a reason to rally the Dimmers to conflict against another action, and the support to act on that reason. You gain 1d4 Fear."
        }
    }
    }

    #caulADVCaspertolOtheidas4 ^"Casper tol-Otheidas" DEF {
        EXTENDS #daggerheartAdversary000000001 ^"Adversary"
        PROPERTIES {
