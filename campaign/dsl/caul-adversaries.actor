    }
        EXPERIENCES {
        ^"Forethought" INTEGER 3
        ^"Magical Knowledge" INTEGER 4
    }
        FEATURES {
        #caulAF619f15995aadf6e5e6 ^"Relentless (3)" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "The Archwizard can be spotlighted up to three times per GM turn. Spend Fear as usual to spotlight them."
        }
        #caulAFa5b1f4823c8cfdba0f ^"Arcane Slip" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "Archmage may teleport up to a Far range as part of their action."
        }
        #caulAF69e3a2539aed3e1a03 ^"Duplicates" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "Mark a Stress to create 2 duplicates of the Archwizard within Close range, disguising which one is real. The duplicates have the same difficulty as the Archwizard, but cannot use any of the archwizard’s action or reaction features. When a duplicate suffers damage, it disappears. Archmage may not have more than 2 duplicates active at once."
        }
        #caulAFad8a30a5b84bc772f9 ^"Rain of Fire" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "Mark 2 Stress and pick a point within Far range. All targets within Close range of that point must make an Agility Reaction Roll or suffer 4d20 magic damage. If more than two targets fail, gain a Fear."
        }
        #caulAFef86bfb0621f3e2f14 ^"Casual Dismissal" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "When a spell or feature from a class or subclass with a Spellcast Trait is used by a target within Far, force the caster to make a Spellcast Reaction Roll. On a failure, spend a Fear to force the target to mark 2 Stress or cancel the spell with no effect."
        }
    }
    }

