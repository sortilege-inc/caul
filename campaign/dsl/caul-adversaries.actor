        FEATURES {
        #caulAFeb388341708f66d260 ^"Slow Firing" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "When you spotlight the @Lookup[@name] and they don’t have a token on their stat block, they can’t make a standard attack. Place a token on their stat block and describe what they’re preparing to do. When you spotlight the @Lookup[@name] and they have a token on their stat block, clear the token and they can attack."
        }
        #caulAFa63665db0865182d6e ^"Mark Target" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "Spend a Fear to Mark a target within Far range until the @Lookup[@name] is destroyed or the Marked target becomes Hidden. While the target is Marked, their Evasion is halved."
        }
        #caulAF3b3447ab7e8d1ed3f6 ^"Concentrate Fire" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "When another adversary deals damage to a target within Far range of the @Lookup[@name], you can mark a Stress to add the @Lookup[@name]’s standard attack damage to the damage roll."
        }
        #caulAF55612db6697cef30e6 ^"Detonation" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "When the @Lookup[@name] is destroyed, they explode. All targets within Close range must make an Agility Reaction Roll. Targets who fail take 3d20 physical damage. Targets who succeed take half damage. @Template[type:emanation|range:c]"
        }
    }
