        ^"Blessed Spear" DEF { ^"Range" STRING "Very Close" ^"Damage" STRING "4d8+8 phy" }
    }
        EXPERIENCES {
        ^"Leadership" INTEGER 3
        ^"Soldier" INTEGER 3
    }
        FEATURES {
        #caulAF732ddb71a37414ecda ^"Relentless (3)" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "The God-King can be spotlighted up to three times per GM turn. Spend Fear as usual to spotlight them."
        }
        #caulAF0a4b82963ec3a5b9a2 ^"Terrifying" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "When the God-King makes a successful attack, all PCs within Far range lose a Hope and you gain a Fear."
        }
        #caulAF1aa92599fabc49d3d8 ^"Kingsguard" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "Spend a Fear to summon a number of Junior Seraphs equal to the number of PCs. They appear at a Close range."
        }
        #caulAF96bed5f968d89ff403 ^"None Shall Stand In My Way" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "Spend 2 Fear to activate God-King and up to 2d4 allies."
        }
        #caulAFb49c4c9f7ad5b51d0d ^"Majestic Disdain" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "When a PC succeeds on an action roil against the God-King, the PC must make a Presence Reaction Roll or mark 1d4 Stress. On a success, they still mark a Stress."
        }
    }
    }

    #caulADVDaggaBrunnvar00005 ^"Dagga Brunnvar" DEF {
        EXTENDS #daggerheartAdversary000000001 ^"Adversary"
        PROPERTIES {
            ^"Tier" INTEGER 3
            ^"Role" STRING "Social"
            ^"Motives & Tactics" LIST [ "Cow civilians", "deliver fell tidings", "satisfy their master", "undermine resistance" ]
            ^"Difficulty" INTEGER 16
            ^"Damage Thresholds" DEF { ^"Major" INTEGER 13 ^"Severe" INTEGER 25 }
            ^"Hit Points" INTEGER 3
            ^"Stress" INTEGER 5
            ^"Attack Modifier" INTEGER 1
        }
        ATTACK {
        ^"Wand" DEF { ^"Range" STRING "Far" ^"Damage" STRING "3d6 mag" }
    }
        EXPERIENCES {
        ^"Orator" INTEGER 4
        ^"Geography" INTEGER 3
    }
        FEATURES {
        #caulAF72287e377642687bf8 ^"Aura of Superiority" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "Any time a PC rolls with Fear while in the presence of the Herald, they must mark a Stress."
        }
        #caulAF841a5eaab3e713cb99 ^"Your Doom Comes" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "Spend 2 Fear to have the Herald deliver news of their master’s imminent arrival to conquer the local community, boasting about the Warlord’s many victories. All targets within Far range must make a Presence Reaction Roll or mark 2 Stress."
        }
        #caulAFa44b05817fa29b7285 ^"Silence, Worm!" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "Mark a Stress and force a target within Far range to make a Presence Reaction Roll. On a failure, they become Cowed. While Cowed, they are Vulnerable and must mark a Stress any time they speak out against the Herald. The target clears Cowed on a success with Hope or during their next rest."
        }
        #caulAFa03839f2ddd1eb9bd1 ^"Withering Contempt" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "When a PC makes a Presence Roll against the Herald, mark a Stress to give the roll disadvantage."
        }
        #caulAFaf48fa647f621b5dd7 ^"My Master Is Not Without Mercy" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "Any target that pledges loyalty or surrenders proactively becomes Suborned. A Suborned target cannot clear Stress but is granted a reprieve from the worst of the oncoming conquest. A target can clear Suborned by taking dangerous action against the Herald’s master."
        }
    }
    }

    #caulADVInolaWendingKeepe6 ^"Inola Wending, Keeper of Splendor" DEF {
        EXTENDS #daggerheartAdversary000000001 ^"Adversary"
        PROPERTIES {
            ^"Tier" INTEGER 4
            ^"Role" STRING "Solo"
            ^"Motives & Tactics" LIST [ "Dismiss the weaklings", "perfect in everything" ]
            ^"Difficulty" INTEGER 20
            ^"Damage Thresholds" DEF { ^"Major" INTEGER 35 ^"Severe" INTEGER 60 }
            ^"Hit Points" INTEGER 11
            ^"Stress" INTEGER 8
            ^"Attack Modifier" INTEGER 5
        }
        ATTACK {
        ^"Blade of Splendor" DEF { ^"Range" STRING "Close" ^"Damage" STRING "4d12+10 mag" }
    }
        EXPERIENCES {
        ^"Perfect In Everything" INTEGER 2
    }
        FEATURES {
        #caulAFabdec2a1fa461442f2 ^"Relentless (3)" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "The Avatar of Pride can be spotlighted up to three times per GM turn. Spend Fear as usual to spotlight them."
        }
        #caulAF6a11537f3f5d0d1013 ^"Perfect Duelist" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "When the Avatar of Pride makes an attack against a target and if there are no other targets within Melee range, the Avatar has advantage on the attack. Spend a Fear to make it a sinful advantage for an attack."
        }
        #caulAFb510a51e276bfbcc92 ^"Perfect Strike" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "Spend 2 Fear and make a standard attack against a target within range. If the attack hits, the attack deals direct damage."
        }
        #caulAFde3ce4ee49db8108d8 ^"Do Not Fear Death" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "Mark a Stress to fill a target within Close range with Pride. The target can mark a Stress to clear 1d4 HP."
        }
        #caulAF058fc53b6135ff59ed ^"Your Efforts Are Futile" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "Each PC within Close range must make a Presence Reaction Roll. Targets who fail lose 5 Hope."
        }
        #caulAFc767d55b6a60030ee4 ^"Victory Is Not Possible" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "When the Avatar of Pride makes a successful action roll against a PC, you gain a Fear."
        }
        #caulAF68f4a0a87b1a81223a ^"Overwhelming Power" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "Countdown (12). When the Avatar is in the spotlight for the first time, activate the countdown. The countdown ticks down whenever a PC gains the spotlight. When it triggers, all PCs lose all their Hopes, and you gain an equal number of Fear. The Avatar also clears all Hit Points and Stress. You must spend all Fears one by one, giving Avatar the spotlight without letting anyone take it until you run out of Fear."
        }
    }
    }

