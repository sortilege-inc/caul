    #caulADVTheRuntGod00000009 ^"The Runt God" DEF {
        EXTENDS #daggerheartAdversary000000001 ^"Adversary"
        PROPERTIES {
            ^"Tier" INTEGER 4
            ^"Role" STRING "Bruiser"
            ^"Motives & Tactics" LIST [ "Demolish", "Devour", "Undermine" ]
            ^"Difficulty" INTEGER 19
            ^"Damage Thresholds" DEF { ^"Major" INTEGER 35 ^"Severe" INTEGER 71 }
            ^"Hit Points" INTEGER 7
            ^"Stress" INTEGER 5
        }
        ATTACK {
        ^"Massive Pseudopod" DEF { ^"Range" STRING "Very Close" ^"Damage" STRING "4d8+13 mag" }
    }
        FEATURES {
        #caulAF5ee954ee3d6dbe54f0 ^"Chaotic Form" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "When the Abomination attacks, roll 2d4 and use the result as their attack modifier."
        }
        #caulAFeba7713b7239150071 ^"Disorienting Presence" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "When a target takes damage from the Abomination, they must make an Instinct Reaction Roll. On a failure, they gain disadvantage on their next action roll and you gain a Fear."
        }
        #caulAF869cefa642d2be5d36 ^"Reality Quake" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "Spend a Fear to rattle the edges of reality within Far range of the Abomination. All targets within that area must succeed on a Knowledge Reaction Roll or become Unstuck from reality until the end of the scene. When an Unstuck target spends Hope or marks Armor Slots, HP, or Stress, they must double the amount spent or marked."
        }
        #caulAF52212fce9ea60f1538 ^"Unreal Form" DEF {
            EXTENDS #daggerheartAdvFeature00000001 ^"Adversary Feature"
            ^"Description" STRING "When the Abomination takes damage, reduce it by 1d20. If the Abomination marks 1 or fewer Hit Points from a successful attack against them, you gain a Fear."
        }
    }
    }

    #caulADVTherionCalanthe000 ^"Therion Calanthe" DEF {
        EXTENDS #daggerheartAdversary000000001 ^"Adversary"
        PROPERTIES {
            ^"Tier" INTEGER 4
            ^"Role" STRING "Solo"
            ^"Motives & Tactics" LIST [ "Achieve the impossible", "conjure marvels", "defy pursuit", "reveal contingency plans", "sunder the earth" ]
            ^"Difficulty" INTEGER 20
            ^"Damage Thresholds" DEF { ^"Major" INTEGER 30 ^"Severe" INTEGER 60 }
            ^"Hit Points" INTEGER 9
            ^"Stress" INTEGER 8
            ^"Attack Modifier" INTEGER 5
        }
